/* ========================================
   AGRINHO - AGRO FORTE
   CSS Principal - Versão limpa e sem erros
======================================== */

:root {
  /* Cores principais */
  --verde-principal: #2e7d32;
  --verde-escuro: #1b5e20;
  --verde-claro: #4caf50;
  --verde-suave: #e8f5e9;
  
  --terra: #8d6e63;
  --terra-escura: #5d4037;
  --dourado: #f9a825;
  
  --branco: #ffffff;
  --cinza-claro: #f5f5f5;
  --cinza: #757575;
  --preto: #212121;
  
  /* Tipografia */
  --fonte-principal: 'Segoe UI', system-ui, -apple-system, sans-serif;
  --fonte-titulo: 'Montserrat', 'Segoe UI', sans-serif;
  
  /* Espaçamentos e efeitos */
  --espaco: 1rem;
  --raio: 8px;
  --sombra: 0 4px 12px rgba(0, 0, 0, 0.1);
  --transicao: 0.3s ease;
}

/* Reset básico */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--fonte-principal);
  background-color: var(--cinza-claro);
  color: var(--preto);
  line-height: 1.6;
}

/* ========== Tipografia ========== */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--fonte-titulo);
  font-weight: 700;
  color: var(--verde-escuro);
  line-height: 1.3;
}

h1 { font-size: 2.8rem; }
h2 { font-size: 2.2rem; }
h3 { font-size: 1.6rem; }

p {
  margin-bottom: 1rem;
  color: var(--cinza);
}

a {
  color: var(--verde-principal);
  text-decoration: none;
  transition: var(--transicao);
}

a:hover {
  color: var(--verde-escuro);
}

/* ========== Header / Navegação ========== */
.header {
  background: var(--branco);
  box-shadow: var(--sombra);
  position: sticky;
  top: 0;
  z-index: 1000;
  padding: 0.8rem 0;
}

.nav-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 1.5rem;
}

.logo {
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--verde-escuro);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.logo span {
  color: var(--dourado);
}

.nav-menu {
  display: flex;
  list-style: none;
  gap: 2rem;
}

.nav-menu a {
  font-weight: 600;
  color: var(--preto);
  position: relative;
}

.nav-menu a::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--verde-principal);
  transition: var(--transicao);
}

.nav-menu a:hover::after {
  width: 100%;
}

/* ========== Hero Section ========== */
.hero {
  background: linear-gradient(135deg, var(--verde-escuro), var(--verde-principal));
  color: var(--branco);
  padding: 6rem 1.5rem;
  text-align: center;
}

.hero h1 {
  color: var(--branco);
  font-size: 3.2rem;
  margin-bottom: 1rem;
}

.hero p {
  color: rgba(255, 255, 255, 0.9);
  font-size: 1.25rem;
  max-width: 700px;
  margin: 0 auto 2rem;
}

/* ========== Botões ========== */
.btn {
  display: inline-block;
  padding: 0.85rem 1.8rem;
  border-radius: var(--raio);
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: var(--transicao);
  border: none;
  text-align: center;
}

.btn-primary {
  background: var(--dourado);
  color: var(--preto);
}

.btn-primary:hover {
  background: #f57f17;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(249, 168, 37, 0.4);
}

.btn-secondary {
  background: transparent;
  border: 2px solid var(--branco);
  color: var(--branco);
}

.btn-secondary:hover {
  background: var(--branco);
  color: var(--verde-escuro);
}

.btn-outline {
  background: transparent;
  border: 2px solid var(--verde-principal);
  color: var(--verde-principal);
}

.btn-outline:hover {
  background: var(--verde-principal);
  color: var(--branco);
}

/* ========== Seções gerais ========== */
.section {
  padding: 5rem 1.5rem;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

.section-title {
  text-align: center;
  margin-bottom: 3rem;
}

.section-title h2 {
  position: relative;
  display: inline-block;
}

.section-title h2::after {
  content: '';
  display: block;
  width: 60px;
  height: 4px;
  background: var(--dourado);
  margin: 0.8rem auto 0;
  border-radius: 2px;
}

/* ========== Cards ========== */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
}

.card {
  background: var(--branco);
  border-radius: var(--raio);
  overflow: hidden;
  box-shadow: var(--sombra);
  transition: var(--transicao);
}

.card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
}

.card-img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.card-body {
  padding: 1.5rem;
}

.card-body h3 {
  margin-bottom: 0.75rem;
  color: var(--verde-escuro);
}

/* ========== Destaque ========== */
.destaque {
  background: var(--verde-suave);
}

/* ========== Formulários ========== */
.form-group {
  margin-bottom: 1.25rem;
}

.form-group label {
  display: block;
  margin-bottom: 0.4rem;
  font-weight: 600;
  color: var(--verde-escuro);
}

.form-control {
  width: 100%;
  padding: 0.85rem 1rem;
  border: 2px solid #e0e0e0;
  border-radius: var(--raio);
  font-size: 1rem;
  transition: var(--transicao);
}

.form-control:focus {
  outline: none;
  border-color: var(--verde-principal);
  box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.2);
}

/* ========== Footer ========== */
.footer {
  background: var(--verde-escuro);
  color: var(--branco);
  padding: 3.5rem 1.5rem 1.5rem;
}

.footer-content {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 2.5rem;
  margin-bottom: 2.5rem;
}

.footer h4 {
  color: var(--dourado);
  margin-bottom: 1rem;
}

.footer a {
  color: rgba(255, 255, 255, 0.8);
}

.footer a:hover {
  color: var(--dourado);
}

.footer-bottom {
  text-align: center;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.9rem;
}

/* ========== Responsividade ========== */
@media (max-width: 768px) {
  .nav-menu {
    display: none;
  }

  .hero h1 {
    font-size: 2.4rem;
  }

  h1 { font-size: 2.2rem; }
  h2 { font-size: 1.8rem; }
}

@media (max-width: 480px) {
  .hero {
    padding: 4rem 1rem;
  }
  
  .hero h1 {
    font-size: 2rem;
  }
}
