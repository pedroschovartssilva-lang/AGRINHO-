
/* ==============================
   AGRINHO - STYLE.CSS
   ============================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f9f1;
    color: #333;
    line-height: 1.6;
}

/* ===== CABEÇALHO ===== */

header {
    background: linear-gradient(135deg, #2e7d32, #66bb6a);
    color: white;
    padding: 20px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    font-size: 28px;
    font-weight: bold;
}

.logo span {
    color: #ffeb3b;
}

/* ===== MENU ===== */

nav ul {
    list-style: none;
    display: flex;
    gap: 25px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

nav a:hover {
    color: #ffeb3b;
}

/* ===== BANNER PRINCIPAL ===== */

.hero {
    min-height: 500px;
    padding: 80px 8%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(
        rgba(46, 125, 50, 0.75),
        rgba(102, 187, 106, 0.75)
    );
    color: white;
}

.hero-content {
    max-width: 800px;
}

.hero h1 {
    font-size: 50px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 20px;
    margin-bottom: 30px;
}

/* ===== BOTÕES ===== */

.btn {
    display: inline-block;
    background-color: #ffca28;
    color: #333;
    padding: 12px 25px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.btn:hover {
    background-color: #ffb300;
    transform: translateY(-3px);
}

/* ===== SEÇÕES ===== */

section {
    padding: 70px 8%;
}

section h2 {
    text-align: center;
    color: #2e7d32;
    font-size: 35px;
    margin-bottom: 40px;
}

/* ===== CARDS ===== */

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.card {
    background-color: white;
    padding: 30px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    transition: 0.3s;
    border-top: 5px solid #66bb6a;
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}

.card h3 {
    color: #2e7d32;
    margin-bottom: 15px;
}

.card p {
    color: #555;
}

/* ===== SOBRE ===== */

.sobre {
    background-color: #e8f5e9;
}

.sobre-content {
    max-width: 900px;
    margin: auto;
    text-align: center;
}

/* ===== IMAGENS ===== */

img {
    max-width: 100%;
    height: auto;
    border-radius: 15px;
}

.imagem-destaque {
    display: block;
    width: 80%;
    margin: 30px auto;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
}

/* ===== RODAPÉ ===== */

footer {
    background-color: #1b5e20;
    color: white;
    text-align: center;
    padding: 30px 8%;
}

footer p {
    margin: 5px 0;
}

footer a {
    color: #ffeb3b;
    text-decoration: none;
}

/* ===== RESPONSIVIDADE ===== */

@media (max-width: 768px) {

    header {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }

    nav ul {
        flex-direction: column;
        gap: 10px;
    }

    .hero {
        min-height: 400px;
        padding: 60px 5%;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero p {
        font-size: 17px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    section {
        padding: 50px 5%;
    }

    section h2 {
        font-size: 28px;
    }

    .imagem-destaque {
        width: 100%;
    }
}
